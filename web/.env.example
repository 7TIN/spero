# Optional. Defaults to http://localhost:3000.
VITE_API_URL=http://localhost:3000

# Optional MapTiler or Stadia style. Uncomment a pair and add your key to use
# them. Without these the app uses the free CARTO light and dark basemaps.
# VITE_MAP_STYLE_URL=https://api.maptiler.com/maps/streets-v2/style.json?key=YOUR_MAPTILER_KEY
# VITE_MAP_STYLE_URL_DARK=https://api.maptiler.com/maps/streets-v2-dark/style.json?key=YOUR_MAPTILER_KEY
