# API server
PORT=3000
CORS_ORIGIN=http://localhost:5173

# Which hosted POI provider to use: "geoapify" or "overpass".
# Optional; defaults to geoapify when GEOAPIFY_API_KEY is set, else overpass.
# POI_PROVIDER=geoapify

# Geoapify Places API key. Free plan: 3,000 credits/day.
# Create one at https://myprojects.geoapify.com/ and paste it here.
GEOAPIFY_API_KEY=

# Overpass API endpoints, tried in order until one answers. Optional; the
# defaults are the six global public servers below. Do not add region-limited
# mirrors (e.g. overpass.osm.ch) or their empty results will be cached.
# OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter,https://overpass.private.coffee/api/interpreter,https://overpass.osm.jp/api/interpreter,https://overpass.openstreetmap.ru/api/interpreter,https://overpass.nchc.org.tw/api/interpreter

# Identify the app to Overpass. Optional.
# OVERPASS_USER_AGENT=spero/0.1 (+https://github.com/7TIN/spero)

# SQLite tile cache file. Optional; defaults to core/data/tiles.sqlite locally
# and /tmp/spero/tiles.sqlite on Vercel.
# TILE_CACHE_PATH=./data/tiles.sqlite

# Nominatim geocoding endpoint and User-Agent. Optional; defaults to the
# public OpenStreetMap instance. Use a self-hosted instance for production.
# NOMINATIM_URL=https://nominatim.openstreetmap.org/search
# NOMINATIM_USER_AGENT=Spero/0.1 (+https://github.com/7TIN/spero)

# Spero Agent (bottom chat box). Optional: without a key the server uses a
# deterministic quick planner for common map requests. Get a key at
# https://aistudio.google.com/apikey and keep it server-side only.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
